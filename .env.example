# Blogger and browser-safe site configuration.
VITE_CONTENT_PROVIDER=blogger
VITE_CONTENT_MODE=blog
VITE_BLOGGER_API_URL=https://www.googleapis.com/blogger/v3
VITE_BLOGGER_BLOG_ID=
VITE_BLOGGER_CLIENT_ID=
# Public browser API key. Restrict to Blogger API and your authorized site origins in Google Cloud.
VITE_BLOGGER_API_KEY=
VITE_SITE_NAME=Promptseen
VITE_ADMIN_DISPLAY_NAME=Creator
VITE_SITE_URL=http://localhost:5174
VITE_GA_MEASUREMENT_ID=
VITE_LOCAL_PROMPTS_STORAGE_KEY=promptseen:local-prompts
# Server-only social API settings. Never prefix these values with VITE_.
# X API v2 recent search requires an X developer app with Posts: Read access.
SOCIAL_X_API_URL=https://api.x.com/2
SOCIAL_X_BEARER_TOKEN=
SOCIAL_X_SEARCH_QUERY=("AI prompt" OR "Gemini prompt" OR "Midjourney prompt") -is:retweet
SOCIAL_RELEVANCE_TERMS=prompt,ai,aiart,gemini,midjourney,flux,stable diffusion,chatgpt,ai art

# Instagram hashtag search requires an Instagram Professional account, a Meta app,
# and the permissions/access review required for public hashtag content.
SOCIAL_INSTAGRAM_API_URL=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=
SOCIAL_INSTAGRAM_USER_ID=
SOCIAL_INSTAGRAM_HASHTAGS=aiart,gemini,midjourney

# Browser-local menu editor storage key
VITE_SIDE_MENUS_STORAGE_KEY=promptseen:side-menus

# Server-only Creator Studio password login; never prefix these with VITE_.
ADMIN_USER_ID=
ADMIN_PASSWORD=
# Use a stable, randomly generated secret with at least 32 bytes.
ADMIN_SESSION_SECRET=

# PostgreSQL connection for the persistent product catalog (server only).
DATABASE_URL=
# Set DATABASE_SSL=disable only for local PostgreSQL without TLS.
DATABASE_SSL=

# Server-only OpenAI key for photo-to-prompt generation. Never use a VITE_ prefix.
OPENAI_API_KEY=

# Required for encrypted file storage of AI provider keys.
# Use a stable random secret with at least 32 bytes; never prefix with VITE_.
AI_SETTINGS_ENCRYPTION_KEY=
# Optional: override the default server-side data/ai-model-settings.json path.
AI_MODEL_CONFIG_FILE=
